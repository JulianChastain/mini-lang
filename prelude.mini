-- The prelude. The REPL loads it, and so does running a program, unless
-- you pass --no-prelude.

type Bool = True | False
type Option a = None | Some a
type List a = Nil | Cons a (List a)

let not : Bool -> Bool = /b -> if b then False else True

let rec map : forall a b. (a -> b) -> List a -> List b =
  /f -> /xs -> match xs with
    | [] -> []
    | Cons x rest -> Cons (f x) (map f rest)

let rec filter : forall a. (a -> Bool) -> List a -> List a =
  /keep -> /xs -> match xs with
    | [] -> []
    | Cons x rest -> if keep x then Cons x (filter keep rest) else filter keep rest

let rec foldr : forall a b. (a -> b -> b) -> b -> List a -> b =
  /f -> /z -> /xs -> match xs with
    | [] -> z
    | Cons x rest -> f x (foldr f z rest)

-- Both are folds; append passes the constructor Cons as the function.
let length : forall a. List a -> Int = foldr (/x -> /n -> n + 1) 0
let append : forall a. List a -> List a -> List a = /xs -> /ys -> foldr Cons ys xs
